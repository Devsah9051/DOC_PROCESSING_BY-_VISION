# EGCA Phase 1 environment
# Copy to .env and fill in values before running.

# Local PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/egca

# Ed25519 seal key (base64-encoded 32-byte private key).
# Generate one: python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey; import base64; print(base64.b64encode(Ed25519PrivateKey.generate().private_bytes_raw()).decode())"
SEAL_KEY=replace_with_base64_ed25519_private_key
